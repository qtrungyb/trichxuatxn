        .settings-table { width: 100%; border-collapse: collapse; text-align: left; font-size: 13px; }
        .settings-table td { padding: 9px 20px; border-bottom: 1px solid var(--border-light); }
        .settings-table tr.data-row { cursor: pointer; transition: background-color 0.1s; }
        .settings-table tr.data-row:hover td { background-color: var(--bg-subtle); }
        .settings-table tr.data-row.is-selected td { background-color: rgba(37, 99, 235, 0.03); }
        .col-check { width: 42px; text-align: center; }
        .col-name { font-weight: 500; color: var(--text-main); }
        .col-result { width: 35%; text-align: right; color: var(--text-muted); font-family: 'JetBrains Mono', monospace; font-size: 12px; }
        .checkbox-custom { width: 16px; height: 16px; cursor: pointer; accent-color: var(--primary); vertical-align: middle; }

