        function encodeKey(k) {
            if (k === null || k === undefined) return 'k_';
            const s = String(k).replace(/\./g, '__DOT__').replace(/#/g, '__HASH__').replace(/\$/g, '__DOLLAR__').replace(/\//g, '__SLASH__').replace(/\[/g, '__LBRACKET__').replace(/\]/g, '__RBRACKET__');
            return 'k_' + s;
        }
        function decodeKey(k) {
            if (k === null || k === undefined) return k;
            let s = String(k);
            if (s.startsWith('k_')) s = s.slice(2);
            return s.replace(/__DOT__/g, '.').replace(/__HASH__/g, '#').replace(/__DOLLAR__/g, '$').replace(/__SLASH__/g, '/').replace(/__LBRACKET__/g, '[').replace(/__RBRACKET__/g, ']');
        }
        function sanitizeDataForFirebase(data) {
            if (!Array.isArray(data)) return [];
            return data.map(row => {
                const newRow = { hoTen: row.hoTen || '', tuoi: row.tuoi || '', gioiTinh: row.gioiTinh || '', tests: {}, testCategories: {} };
                if (row.tests) Object.keys(row.tests).forEach(k => { newRow.tests[encodeKey(k)] = row.tests[k]; });
                if (row.testCategories) Object.keys(row.testCategories).forEach(k => { newRow.testCategories[encodeKey(k)] = row.testCategories[k]; });
                return newRow;
            });
        }
        function desanitizeDataFromFirebase(data) {
            let arr = data;
            if (!arr) return [];
            if (!Array.isArray(arr)) arr = Object.keys(arr).sort((a, b) => Number(a) - Number(b)).map(k => arr[k]);
            return arr.filter(r => r !== null && r !== undefined).map(row => {
                const newRow = { hoTen: row.hoTen || '', tuoi: row.tuoi || '', gioiTinh: row.gioiTinh || '', tests: {}, testCategories: {} };
                if (row.tests && typeof row.tests === 'object') Object.keys(row.tests).forEach(k => { newRow.tests[decodeKey(k)] = row.tests[k]; });
                if (row.testCategories && typeof row.testCategories === 'object') Object.keys(row.testCategories).forEach(k => { newRow.testCategories[decodeKey(k)] = row.testCategories[k]; });
                return newRow;
            });
        }

        /* ===== FIREBASE HELPERS ===== */
        function getDeviceId() {
            let id = localStorage.getItem('vox_device_id');
            if (!id) { id = 'dev_' + Math.random().toString(36).slice(2, 10) + '_' + Date.now().toString(36); localStorage.setItem('vox_device_id', id); }
            return id;
        }
        function initFirebase() {
            try {
                if (typeof firebase === 'undefined' || !firebase.initializeApp) { firebaseInitState = 'error'; return; }
                if (!firebase.apps.length) firebase.initializeApp(FIREBASE_CONFIG);
                firebaseDb = firebase.database();
                firebaseInitState = 'ready';
                loadFromFirebase();
                loadHistoryFromFirebase();
                listenSharedHistory();
            } catch (e) { firebaseInitState = 'error'; }
        }
        function scheduleLocalSave(delay = 200) {
            if (localSaveTimer) clearTimeout(localSaveTimer);
            localSaveTimer = setTimeout(() => {
                try { localStorage.setItem('vox_current_data', JSON.stringify(currentData)); } catch (e) {}
            }, delay);
        }
        function saveImmediatelyToLocal() {
            try { localStorage.setItem('vox_current_data', JSON.stringify(currentData)); } catch (e) {}
        }
        function scheduleFirebaseSync(delay = 1000) {
            if (firebaseInitState !== 'ready' || !firebaseDb) return;
            if (firebaseSaveTimer) clearTimeout(firebaseSaveTimer);
            firebaseSaveTimer = setTimeout(syncToFirebase, delay);
        }
        function syncToFirebase() {
            if (firebaseInitState !== 'ready' || !firebaseDb) return;
            try {
                const deviceId = getDeviceId();
                const ref = firebaseDb.ref('workspaces/' + deviceId);
                const payload = { currentData: sanitizeDataForFirebase(currentData), activeColumns: activeColumns, updatedAt: Date.now(), deviceId: deviceId };
                ref.set(payload).catch(err => console.error('[Firebase] Sync failed:', err));
            } catch (e) { console.error('[Firebase] Sync exception:', e); }
        }
        function loadFromFirebase() {
            if (!firebaseDb) return;
            try {
                const deviceId = getDeviceId();
                const ref = firebaseDb.ref('workspaces/' + deviceId);
                ref.once('value').then(snapshot => {
                    const val = snapshot.val();
                    if (val && val.currentData) {
                        const restored = desanitizeDataFromFirebase(val.currentData);
                        if (restored.length > 0) {
                            if (currentData.length === 0) {
                                currentData = restored;
                                if (Array.isArray(val.activeColumns) && val.activeColumns.length > 0) activeColumns = val.activeColumns;
                                rebuildDynamicColumns();
                                if (!activeColumns || activeColumns.length === 0) activeColumns = getDefaultColumns();
                                saveImmediatelyToLocal();
                                renderTable();
                                showToast("Đã khôi phục dữ liệu từ Cloud!");
                            } else scheduleFirebaseSync(0);
                            return;
                        }
                    }
                    if (currentData.length > 0) scheduleFirebaseSync(0);
                }).catch(err => console.error(err));
            } catch (e) { console.error(e); }
        }

        /* ===== SHARED HISTORY ===== */
        function saveHistoryToFirebase(record) {
            if (firebaseInitState !== 'ready' || !firebaseDb) return Promise.reject(new Error('Firebase not ready'));
            const data = { time: record.time, count: record.count, data: sanitizeDataForFirebase(record.data || []) };
            return firebaseDb.ref(SHARED_HISTORY_PATH + '/' + record.id).set(data);
        }
        function deleteHistoryFromFirebase(id) {
            if (firebaseInitState !== 'ready' || !firebaseDb) return Promise.reject(new Error('Firebase not ready'));
            const updates = {};
            updates[SHARED_HISTORY_PATH + '/' + id] = null;
            updates[SHARED_HISTORY_DELETED_PATH + '/' + id] = Date.now();
            return firebaseDb.ref().update(updates);
        }
        function mergeHistoryFromCloud(cloud, deleted) {
            const localHistory = JSON.parse(localStorage.getItem('vox_history')) || [];
            const tombstoned = new Set(Object.keys(deleted || {}).map(k => Number(k)).filter(n => !isNaN(n) && n > 0));
            const merged = new Map();
            Object.keys(cloud || {}).forEach(k => {
                const id = Number(k);
                if (!id || tombstoned.has(id)) return;
                const item = cloud[k] || {};
                merged.set(id, { id: id, time: item.time || '', count: item.count || 0, data: desanitizeDataFromFirebase(item.data || []) });
            });
            localHistory.forEach(h => {
                if (!tombstoned.has(h.id) && !merged.has(h.id)) merged.set(h.id, h);
            });
            return Array.from(merged.values()).sort((a, b) => b.id - a.id);
        }
        function loadHistoryFromFirebase() {
            if (!firebaseDb) return;
            firebaseDb.ref('history').once('value').then(snap => {
                const val = snap.val() || {};
                const merged = mergeHistoryFromCloud(val.shared || {}, val.shared_deleted || {});
                const localHistory = JSON.parse(localStorage.getItem('vox_history')) || [];
                if (JSON.stringify(merged) !== JSON.stringify(localHistory)) {
                    localStorage.setItem('vox_history', JSON.stringify(merged));
                    renderHistory();
                }
                const cloudIds = new Set(Object.keys(val.shared || {}).map(k => Number(k)));
                const toPush = merged.filter(h => !cloudIds.has(h.id) && !(val.shared_deleted && val.shared_deleted[h.id]));
                if (toPush.length > 0) {
                    const updates = {};
                    toPush.forEach(h => {
                        updates[SHARED_HISTORY_PATH + '/' + h.id] = { time: h.time, count: h.count, data: sanitizeDataForFirebase(h.data || []) };
                    });
                    firebaseDb.ref().update(updates).catch(err => console.error(err));
                }
            }).catch(err => console.error(err));
        }
        function listenSharedHistory() {
            if (!firebaseDb) return;
            const ref = firebaseDb.ref('history');
            if (sharedHistoryListener) ref.off('value', sharedHistoryListener);
            sharedHistoryListener = ref.on('value', snap => {
                const val = snap.val() || {};
                const merged = mergeHistoryFromCloud(val.shared || {}, val.shared_deleted || {});
                const localHistory = JSON.parse(localStorage.getItem('vox_history')) || [];
                if (JSON.stringify(merged) !== JSON.stringify(localHistory)) {
                    localStorage.setItem('vox_history', JSON.stringify(merged));
                    renderHistory();
                }
            }, err => console.error(err));
        }
        function persistChanges(immediate = false) {
            if (immediate) { saveImmediatelyToLocal(); scheduleFirebaseSync(0); }
            else { scheduleLocalSave(200); scheduleFirebaseSync(1000); }
        }

