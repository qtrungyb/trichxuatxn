        function loadHistory(id) {
            let history = JSON.parse(localStorage.getItem('vox_history')) || [];
            let record = history.find(item => item.id === id);
            if (record) {
                currentData = record.data;
                rebuildDynamicColumns();
                if (activeColumns.length <= BASE_COLUMNS.length) activeColumns = getDefaultColumns();
                renderTable();
                switchTab({ currentTarget: document.getElementById('tabBtnPdf') }, 'tab-pdf');
                persistChanges(true);
                showToast("Đã khôi phục dữ liệu từ lịch sử!");
            }
        }

        function requestDeleteHistory(id) {
            pendingDeleteHistoryId = id;
            renderHistory();
            setTimeout(() => {
                if (pendingDeleteHistoryId === id) {
                    pendingDeleteHistoryId = null;
                    renderHistory();
                }
            }, 3500);
        }

        function confirmDeleteHistory(id) {
            pendingDeleteHistoryId = null;
            let history = JSON.parse(localStorage.getItem('vox_history')) || [];
            history = history.filter(item => item.id !== id);
            localStorage.setItem('vox_history', JSON.stringify(history));
            renderHistory();
            showToast("Đã xóa bản ghi lịch sử!");

            if (firebaseInitState === 'ready') {
                deleteHistoryFromFirebase(id).catch(err => console.error('[Firebase] delete history failed:', err));
            }
        }

        /* ===== PREVIEW MODAL ===== */
        function previewHistory(id) {
            const history = JSON.parse(localStorage.getItem('vox_history')) || [];
