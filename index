    <script>
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.worker.min.js';

        const FIREBASE_CONFIG = {
            apiKey: "AIzaSyCGjF5HdZ4-UQcjSoT2Qqou8rkGAAYVgY0",
            authDomain: "trichxuatcls.firebaseapp.com",
            databaseURL: "https://trichxuatcls-default-rtdb.asia-southeast1.firebasedatabase.app",
            projectId: "trichxuatcls",
            storageBucket: "trichxuatcls.firebasestorage.app",
            messagingSenderId: "106071797365",
            appId: "1:106071797365:web:fffbfe5b2a02bc9107923c"
        };

        const SHARED_HISTORY_PATH = 'history/shared';
        const SHARED_HISTORY_DELETED_PATH = 'history/shared_deleted';

        let firebaseDb = null;
        let firebaseInitState = 'idle';
        let firebaseSaveTimer = null;
        let localSaveTimer = null;
        let sharedHistoryListener = null;
        let previewHistoryId = null;

        const BASE_COLUMNS = [
            { key: 'hoTen', label: 'Họ và tên', category: 'Thông tin Hành chính' },
            { key: 'tuoi', label: 'Tuổi', category: 'Thông tin Hành chính' },
            { key: 'gioiTinh', label: 'Giới tính', category: 'Thông tin Hành chính' }
        ];

        const CATEGORY_ORDER = [
            "Thông tin Hành chính", "Xét nghiệm huyết học", "Xét nghiệm hóa sinh",
            "Xét nghiệm Vi sinh", "Xét nghiệm nước tiểu", "Xét nghiệm khác"
        ];

        let dynamicTestCols = [];
        let activeColumns = JSON.parse(localStorage.getItem('vox_all_active_columns')) || [];
        let currentData = [];
        let pendingDeleteHistoryId = null;

        const ICON_STAR = `<svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>`;
        const ICON_CHECK_ALL = `<svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>`;
        const ICON_TRASH = `<svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>`;

        /* ===== KEY ENCODING ===== */
        function encodeKey(k) {
            if (k === null || k === undefined) return 'k_';
            const s = String(k).replace(/\./g, '__DOT__').replace(/#/g, '__HASH__').replace(/\$/g, '__DOLLAR__').replace(/\//g, '__SLASH__').replace(/\[/g, '__LBRACKET__').replace(/\]/g, '__RBRACKET__');
            return 'k_' + s;
        }
        function decodeKey(k) {
            if (k === null || k === undefined) return k;
            let s = String(k);
            if (s.startsWith('k_')) s = s.slice(2);
            return s.replace(/__DOT__/g, '.').replace(/__HASH__/g, '#').replace(/__DOLLAR__/g, '$').replace(/__SLASH__/g, '/').replace(/__LBRACKET__/g, '[').replace(/__RBRACKET__/g, ']');
        }
        function sanitizeDataForFirebase(data) {
            if (!Array.isArray(data)) return [];
            return data.map(row => {
                const newRow = { hoTen: row.hoTen || '', tuoi: row.tuoi || '', gioiTinh: row.gioiTinh || '', tests: {}, testCategories: {} };
                if (row.tests) Object.keys(row.tests).forEach(k => { newRow.tests[encodeKey(k)] = row.tests[k]; });
                if (row.testCategories) Object.keys(row.testCategories).forEach(k => { newRow.testCategories[encodeKey(k)] = row.testCategories[k]; });
                return newRow;
            });
        }
        function desanitizeDataFromFirebase(data) {
            let arr = data;
            if (!arr) return [];
            if (!Array.isArray(arr)) arr = Object.keys(arr).sort((a, b) => Number(a) - Number(b)).map(k => arr[k]);
            return arr.filter(r => r !== null && r !== undefined).map(row => {
                const newRow = { hoTen: row.hoTen || '', tuoi: row.tuoi || '', gioiTinh: row.gioiTinh || '', tests: {}, testCategories: {} };
                if (row.tests && typeof row.tests === 'object') Object.keys(row.tests).forEach(k => { newRow.tests[decodeKey(k)] = row.tests[k]; });
                if (row.testCategories && typeof row.testCategories === 'object') Object.keys(row.testCategories).forEach(k => { newRow.testCategories[decodeKey(k)] = row.testCategories[k]; });
                return newRow;
            });
        }

        /* ===== FIREBASE HELPERS ===== */
        function getDeviceId() {
            let id = localStorage.getItem('vox_device_id');
            if (!id) { id = 'dev_' + Math.random().toString(36).slice(2, 10) + '_' + Date.now().toString(36); localStorage.setItem('vox_device_id', id); }
            return id;
        }
        function initFirebase() {
            try {
                if (typeof firebase === 'undefined' || !firebase.initializeApp) { firebaseInitState = 'error'; return; }
                if (!firebase.apps.length) firebase.initializeApp(FIREBASE_CONFIG);
                firebaseDb = firebase.database();
                firebaseInitState = 'ready';
                loadFromFirebase();
                loadHistoryFromFirebase();
                listenSharedHistory();
            } catch (e) { firebaseInitState = 'error'; }
        }
        function scheduleLocalSave(delay = 200) {
            if (localSaveTimer) clearTimeout(localSaveTimer);
            localSaveTimer = setTimeout(() => {
                try { localStorage.setItem('vox_current_data', JSON.stringify(currentData)); } catch (e) {}
            }, delay);
        }
        function saveImmediatelyToLocal() {
            try { localStorage.setItem('vox_current_data', JSON.stringify(currentData)); } catch (e) {}
        }
        function scheduleFirebaseSync(delay = 1000) {
            if (firebaseInitState !== 'ready' || !firebaseDb) return;
            if (firebaseSaveTimer) clearTimeout(firebaseSaveTimer);
            firebaseSaveTimer = setTimeout(syncToFirebase, delay);
        }
        function syncToFirebase() {
            if (firebaseInitState !== 'ready' || !firebaseDb) return;
            try {
                const deviceId = getDeviceId();
                const ref = firebaseDb.ref('workspaces/' + deviceId);
                const payload = { currentData: sanitizeDataForFirebase(currentData), activeColumns: activeColumns, updatedAt: Date.now(), deviceId: deviceId };
                ref.set(payload).catch(err => console.error('[Firebase] Sync failed:', err));
            } catch (e) { console.error('[Firebase] Sync exception:', e); }
        }
        function loadFromFirebase() {
            if (!firebaseDb) return;
            try {
                const deviceId = getDeviceId();
                const ref = firebaseDb.ref('workspaces/' + deviceId);
                ref.once('value').then(snapshot => {
                    const val = snapshot.val();
                    if (val && val.currentData) {
                        const restored = desanitizeDataFromFirebase(val.currentData);
                        if (restored.length > 0) {
                            if (currentData.length === 0) {
                                currentData = restored;
                                if (Array.isArray(val.activeColumns) && val.activeColumns.length > 0) activeColumns = val.activeColumns;
                                rebuildDynamicColumns();
                                if (!activeColumns || activeColumns.length === 0) activeColumns = getDefaultColumns();
                                saveImmediatelyToLocal();
                                renderTable();
                                showToast("Đã khôi phục dữ liệu từ Cloud!");
                            } else scheduleFirebaseSync(0);
                            return;
                        }
                    }
                    if (currentData.length > 0) scheduleFirebaseSync(0);
                }).catch(err => console.error(err));
            } catch (e) { console.error(e); }
        }

        /* ===== SHARED HISTORY ===== */
        function saveHistoryToFirebase(record) {
            if (firebaseInitState !== 'ready' || !firebaseDb) return Promise.reject(new Error('Firebase not ready'));
            const data = { time: record.time, count: record.count, data: sanitizeDataForFirebase(record.data || []) };
            return firebaseDb.ref(SHARED_HISTORY_PATH + '/' + record.id).set(data);
        }
        function deleteHistoryFromFirebase(id) {
            if (firebaseInitState !== 'ready' || !firebaseDb) return Promise.reject(new Error('Firebase not ready'));
            const updates = {};
            updates[SHARED_HISTORY_PATH + '/' + id] = null;
            updates[SHARED_HISTORY_DELETED_PATH + '/' + id] = Date.now();
            return firebaseDb.ref().update(updates);
        }
        function mergeHistoryFromCloud(cloud, deleted) {
            const localHistory = JSON.parse(localStorage.getItem('vox_history')) || [];
            const tombstoned = new Set(Object.keys(deleted || {}).map(k => Number(k)).filter(n => !isNaN(n) && n > 0));
            const merged = new Map();
            Object.keys(cloud || {}).forEach(k => {
                const id = Number(k);
                if (!id || tombstoned.has(id)) return;
                const item = cloud[k] || {};
                merged.set(id, { id: id, time: item.time || '', count: item.count || 0, data: desanitizeDataFromFirebase(item.data || []) });
            });
            localHistory.forEach(h => {
                if (!tombstoned.has(h.id) && !merged.has(h.id)) merged.set(h.id, h);
            });
            return Array.from(merged.values()).sort((a, b) => b.id - a.id);
        }
        function loadHistoryFromFirebase() {
            if (!firebaseDb) return;
            firebaseDb.ref('history').once('value').then(snap => {
                const val = snap.val() || {};
                const merged = mergeHistoryFromCloud(val.shared || {}, val.shared_deleted || {});
                const localHistory = JSON.parse(localStorage.getItem('vox_history')) || [];
                if (JSON.stringify(merged) !== JSON.stringify(localHistory)) {
                    localStorage.setItem('vox_history', JSON.stringify(merged));
                    renderHistory();
                }
                const cloudIds = new Set(Object.keys(val.shared || {}).map(k => Number(k)));
                const toPush = merged.filter(h => !cloudIds.has(h.id) && !(val.shared_deleted && val.shared_deleted[h.id]));
                if (toPush.length > 0) {
                    const updates = {};
                    toPush.forEach(h => {
                        updates[SHARED_HISTORY_PATH + '/' + h.id] = { time: h.time, count: h.count, data: sanitizeDataForFirebase(h.data || []) };
                    });
                    firebaseDb.ref().update(updates).catch(err => console.error(err));
                }
            }).catch(err => console.error(err));
        }
        function listenSharedHistory() {
            if (!firebaseDb) return;
            const ref = firebaseDb.ref('history');
            if (sharedHistoryListener) ref.off('value', sharedHistoryListener);
            sharedHistoryListener = ref.on('value', snap => {
                const val = snap.val() || {};
                const merged = mergeHistoryFromCloud(val.shared || {}, val.shared_deleted || {});
                const localHistory = JSON.parse(localStorage.getItem('vox_history')) || [];
                if (JSON.stringify(merged) !== JSON.stringify(localHistory)) {
                    localStorage.setItem('vox_history', JSON.stringify(merged));
                    renderHistory();
                }
            }, err => console.error(err));
        }
        function persistChanges(immediate = false) {
            if (immediate) { saveImmediatelyToLocal(); scheduleFirebaseSync(0); }
            else { scheduleLocalSave(200); scheduleFirebaseSync(1000); }
        }

        /* ===== UI LOGIC ===== */
        document.addEventListener('DOMContentLoaded', () => {
            if (localStorage.getItem('vox_dark_mode') === 'true') { document.body.classList.add('dark-mode'); updateDarkModeIcon(true); }
            if (activeColumns.length === 0) activeColumns = BASE_COLUMNS.map(c => c.key);
            try {
                const savedData = JSON.parse(localStorage.getItem('vox_current_data') || '[]');
                if (Array.isArray(savedData) && savedData.length > 0) {
                    currentData = savedData;
                    rebuildDynamicColumns();
                    if (!activeColumns || activeColumns.length === 0) activeColumns = getDefaultColumns();
                }
            } catch (e) {}
            renderTable();
            renderHistory();
            setupDragAndDrop();
            initFirebase();
        });

        function updateDarkModeIcon(isDark) {
            document.getElementById('darkModeToggle').innerHTML = isDark
                ? `<svg class="svg-icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>`
                : `<svg class="svg-icon" viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>`;
        }
        function toggleDarkMode() {
            document.body.classList.toggle('dark-mode');
            localStorage.setItem('vox_dark_mode', document.body.classList.contains('dark-mode'));
            updateDarkModeIcon(document.body.classList.contains('dark-mode'));
        }

        function toggleHistoryDrawer() {
            const drawer = document.getElementById('historyDrawer');
            const overlay = document.getElementById('drawerOverlay');
            const isActive = drawer.classList.contains('active');
            closeAllDrawers();
            if (!isActive) {
                drawer.classList.add('active');
                overlay.classList.add('active');
                document.getElementById('historyToggleBtn').classList.add('active');
            }
        }

        function toggleColumnDrawer() {
            const drawer = document.getElementById('columnDrawer');
            const overlay = document.getElementById('drawerOverlay');
            const isActive = drawer.classList.contains('active');
            closeAllDrawers();
            if (!isActive) {
                drawer.classList.add('active');
                overlay.classList.add('active');
                renderColumnDrawer();
            }
        }

        function closeAllDrawers() {
            document.querySelectorAll('.drawer').forEach(d => d.classList.remove('active'));
            document.getElementById('drawerOverlay').classList.remove('active');
            document.getElementById('historyToggleBtn').classList.remove('active');
        }

        function toggleSplitDropdown(e) {
            e.stopPropagation();
            const dropdown = document.getElementById('splitDropdown');
            dropdown.classList.toggle('show');
        }
        document.addEventListener('click', () => {
            document.getElementById('splitDropdown').classList.remove('show');
        });

        function showToast(message, isError = false) {
            const toast = document.getElementById('toast');
            toast.innerHTML = (isError ? '⚠️ ' : '✅ ') + message;
            toast.className = "show";
            setTimeout(() => { toast.className = toast.className.replace("show", ""); }, 3000);
        }

        function toggleFileDrawer() { 
            const drawer = document.getElementById('progressContainer');
            if(drawer.style.transform === 'translateY(0px)') {
                drawer.style.transform = 'translateY(-150%)';
            } else {
                drawer.style.transform = 'translateY(0px)';
            }
        }

        function clearCurrentWorkspace() {
            if(!confirm("Bạn có chắc chắn muốn xóa toàn bộ dữ liệu hiện tại?")) return;
            currentData = []; dynamicTestCols = [];
            document.getElementById('progressContainer').style.transform = 'translateY(-150%)';
            document.getElementById('statusPillBtn').style.display = 'none';
            document.getElementById('pdfFileInputHero').value = '';
            document.getElementById('pdfFileInputCompact').value = '';
            renderTable();
            persistChanges(true);
            showToast("Đã làm mới bảng dữ liệu!");
        }

        function getDefaultColumns() {
            let defaults = [...BASE_COLUMNS.map(c => c.key)];
            dynamicTestCols.forEach(c => {
                let cat = (c.category || "").toLowerCase().trim();
                let label = (c.label || "").toLowerCase().trim();
                if (cat.includes("hóa sinh") || cat.includes("vi sinh")) defaults.push(c.key);
                else if (cat.includes("huyết học")) {
                    let targetLabels = ["số lượng hồng cầu", "huyết sắc tố", "số lượng tiểu cầu", "số lượng bạch cầu"];
                    if (targetLabels.some(t => label.includes(t))) defaults.push(c.key);
                }
                else if (cat.includes("nước tiểu")) {
                    if (label === "tỷ trọng" || label === "ph") defaults.push(c.key);
                }
            });
            return [...new Set(defaults)];
        }

        /* ===== RENDER COLUMN DRAWER ===== */
        function renderColumnDrawer() {
            const keyword = document.getElementById('modalSearch').value.toLowerCase().trim();
            const listEl = document.getElementById('columnDrawerList');
            const isSearching = keyword.length > 0;

            // Presets
            const presetEl = document.getElementById('modalPresetRow');
            presetEl.innerHTML = `
                <button type="button" class="btn" style="padding: 4px 10px; font-size: 12px;" onclick="applyPreset('default')">${ICON_STAR} Mặc định</button>
                <button type="button" class="btn" style="padding: 4px 10px; font-size: 12px;" onclick="applyPreset('all')">${ICON_CHECK_ALL} Tất cả</button>
                <button type="button" class="btn" style="padding: 4px 10px; font-size: 12px; color: var(--danger);" onclick="applyPreset('clear')">${ICON_TRASH} Bỏ chọn</button>
            `;

            let cats = getAllCategories();
            let html = '';

            cats.forEach(cat => {
                let cols = cat === "Thông tin Hành chính" ? BASE_COLUMNS : dynamicTestCols.filter(c => c.category === cat);
                if (isSearching) {
                    cols = cols.filter(c => c.label.toLowerCase().includes(keyword));
                }
                if (cols.length === 0) return;

                let dotClass = getDotClass(cat);
                html += `<div class="setting-cat-title"><span class="color-dot ${dotClass}"></span> ${cat}</div>`;
                
                cols.forEach(col => {
                    let isChecked = activeColumns.includes(col.key);
                    let sampleVal = (col.key === 'hoTen' || col.key === 'tuoi' || col.key === 'gioiTinh') ? (currentData[0] ? currentData[0][col.key] : '-') : (col.sampleResult || '-');
                    html += `
                        <label class="setting-item">
                            <input type="checkbox" ${isChecked ? 'checked' : ''} onchange="toggleColumn('${col.key}', this)">
                            <span class="setting-label">${col.label}</span>
                            <span class="setting-sample">${sampleVal}</span>
                        </label>
                    `;
                });
            });

            if (html === '') html = '<div style="text-align:center; padding: 20px; color: var(--text-muted);">Không tìm thấy chỉ số phù hợp.</div>';
            listEl.innerHTML = html;
            
            const allCols = getAllColumns();
            document.getElementById('modalSelectedSummary').innerText = allCols.filter(c => activeColumns.includes(c.key)).length;
        }

        function getDotClass(catName) {
            const c = (catName || "").toLowerCase();
            if (c.includes("hành chính")) return "dot-hanh-chinh";
            if (c.includes("huyết học")) return "dot-huyet-hoc";
            if (c.includes("hóa sinh")) return "dot-hoa-sinh";
            if (c.includes("nước tiểu")) return "dot-nuoc-tieu";
            if (c.includes("vi sinh")) return "dot-vi-sinh";
            return "dot-khac";
        }
        function getAllCategories() {
            let cats = ["Thông tin Hành chính"];
            dynamicTestCols.forEach(col => { if (!cats.includes(col.category)) cats.push(col.category); });
            cats.sort((a, b) => {
                let idxA = CATEGORY_ORDER.indexOf(a), idxB = CATEGORY_ORDER.indexOf(b);
                if (idxA === -1) idxA = 99; if (idxB === -1) idxB = 99;
                return idxA - idxB;
            });
            return cats;
        }

        function toggleColumn(key, checkbox) {
            if (checkbox.checked) { if (!activeColumns.includes(key)) activeColumns.push(key); }
            else activeColumns = activeColumns.filter(k => k !== key);
            localStorage.setItem('vox_all_active_columns', JSON.stringify(activeColumns));
            // Real-time preview
            renderTable();
            scheduleFirebaseSync();
            
            const allCols = getAllColumns();
            document.getElementById('modalSelectedSummary').innerText = allCols.filter(c => activeColumns.includes(c.key)).length;
        }

        function applyPreset(presetType) {
            if (presetType === 'clear') activeColumns = [];
            else if (presetType === 'all') activeColumns = getAllColumns().map(c => c.key);
            else if (presetType === 'default') activeColumns = getDefaultColumns();
            
            activeColumns = [...new Set(activeColumns)];
            localStorage.setItem('vox_all_active_columns', JSON.stringify(activeColumns));
            renderColumnDrawer(); 
            renderTable();
            scheduleFirebaseSync();
        }

        /* ===== DATA RECONSTRUCTION ===== */
        function rebuildDynamicColumns() {
            let testKeys = new Set();
            currentData.forEach(row => { if (row.tests) Object.keys(row.tests).forEach(k => testKeys.add(k)); });
            dynamicTestCols = Array.from(testKeys).map(k => {
                let cat = "Xét nghiệm khác";
                let sample = "-";
                for (let r of currentData) if (r.testCategories && r.testCategories[k]) { cat = r.testCategories[k]; break; }
                for (let r of currentData) if (r.tests && r.tests[k]) { sample = r.tests[k]; break; }
                return { key: `test_${k}`, label: k, category: cat, sampleResult: sample };
            });
        }

        /* ===== PDF PROCESSING ===== */
        function setupDragAndDrop() {
            const heroInput = document.getElementById('pdfFileInputHero');
            const compactInput = document.getElementById('pdfFileInputCompact');
            const heroZone = document.getElementById('dropZoneHero');
            
            heroInput.addEventListener('change', function (e) {
                const files = Array.from(e.target.files || []);
                e.target.value = '';
                if (files.length > 0) processBatchPDF(files, false);
            });
            compactInput.addEventListener('change', function (e) {
                const files = Array.from(e.target.files || []);
                e.target.value = '';
                if (files.length > 0) processBatchPDF(files, true);
            });
            
            heroZone.addEventListener('dragover', (e) => { e.preventDefault(); heroZone.classList.add('dragover'); });
            heroZone.addEventListener('dragleave', (e) => { e.preventDefault(); heroZone.classList.remove('dragover'); });
            heroZone.addEventListener('drop', (e) => {
                e.preventDefault();
                heroZone.classList.remove('dragover');
                const pdfFiles = Array.from(e.dataTransfer.files || []).filter(f => f.type === "application/pdf" || f.name.toLowerCase().endsWith('.pdf'));
                if (pdfFiles.length > 0) processBatchPDF(pdfFiles, false);
                else showToast("Vui lòng chọn file định dạng PDF!", true);
            });
        }

        async function extractDataFromSinglePDF(file) {
            try {
                const arrayBuffer = await file.arrayBuffer();
                const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
                let fullTextLines = [];
                for (let pageNum = 1; pageNum <= pdf.numPages; pageNum++) {
                    const page = await pdf.getPage(pageNum);
                    const textContent = await page.getTextContent();
                    let lines = {};
                    textContent.items.forEach(item => {
                        let y = Math.round(item.transform[5]);
                        if (!lines[y]) lines[y] = [];
                        lines[y].push(item);
                    });
                    let sortedY = Object.keys(lines).map(Number).sort((a, b) => b - a);
                    sortedY.forEach(y => {
                        let lineStr = lines[y].sort((a, b) => a.transform[4] - b.transform[4]).map(item => item.str).join(' ').replace(/\s+/g, ' ').trim();
                        if (lineStr) fullTextLines.push(lineStr);
                    });
                }
                let data = { hoTen: '', tuoi: '', gioiTinh: '', tests: {}, testCategories: {} };
                let currentCategory = "Xét nghiệm khác";
                fullTextLines.forEach(line => {
                    let catMatch = line.match(/^(Xét nghiệm\s+(?:huyết học|Vi sinh|hóa sinh|nước tiểu|đông máu|miễn dịch).*)/i);
                    if (catMatch) { currentCategory = catMatch[1].replace(/\(.*?\)/g, '').trim(); return; }
                    if (line.match(/^(Huyết học|Hóa sinh|Nước tiểu|Vi sinh)/i)) { currentCategory = "Xét nghiệm " + line.replace(/\(.*?\)/g, '').trim(); return; }
                    if (line.includes('Họ và tên:')) {
                        let mTen = line.match(/Họ và tên:\s*(.*?)\s*Tuổi:/i); if (mTen) data.hoTen = mTen[1].trim();
                        let mTuoi = line.match(/Tuổi:\s*(\d+)/i); if (mTuoi) data.tuoi = mTuoi[1].trim();
                        let mGT = line.match(/Giới tính:\s*(Nam|Nữ)/i); if (mGT) data.gioiTinh = mGT[1].trim();
                    }
                    if (line.match(/^(STT|Tên xét nghiệm|Xét nghiệm|Ngày|Trang|Kết quả in đậm)/i)) return;
                    if (line.includes('KHOA XÉT NGHIỆM') || line.includes('Người thực hiện')) return;
                    let cleanLine = line.replace(/^\s+|\s+$/g, '');
                    let resultPattern = /((?:\+\/-|\+|\-)(?:\s*(?:neg|norm|[\d.,]+[A-Za-z%\/\^0-9]*))?|[\d.,]+[A-Za-z%\/\^0-9]*|Âm\s*tính|Dương\s*tính|neg|norm(?:\s*[\d.,]+[A-Za-z%\/\^0-9]*)?|Bình\s*thường|Không\s*phát\s*hiện|\(\+\)|\(-\))/i;
                    let match = cleanLine.match(new RegExp(`^(\\d+)\\s+(.*?)\\s+${resultPattern.source}\\s+(.*)$`, 'i'));
                    if (match) {
                        let testName = match[2].trim().replace(/\s+/g, ' ');
                        let testResult = match[3].trim();
                        if (!data.tests[testName]) { data.tests[testName] = testResult; data.testCategories[testName] = currentCategory; }
                    }
                });
                return data;
            } catch (error) { throw new Error("Không thể đọc file PDF này."); }
        }

        async function processBatchPDF(files, append = false) {
            const statusPillBtn = document.getElementById('statusPillBtn');
            const progressContainer = document.getElementById('progressContainer');
            const barFill = document.getElementById('progressBarFill');
            const progressText = document.getElementById('progressText');
            const progressPercent = document.getElementById('progressPercent');
            const fileListEl = document.getElementById('fileList');
            
            statusPillBtn.style.display = 'inline-flex';
            progressContainer.style.transform = 'translateY(0px)';
            barFill.style.width = '0%';
            progressPercent.innerText = '0%';
            fileListEl.innerHTML = '';
            
            currentData = append ? [...currentData] : [];
            let validFiles = Array.from(files).filter(f => f.type === "application/pdf" || f.name.toLowerCase().endsWith('.pdf'));
            let total = validFiles.length, successCount = 0;
            
            for (let i = 0; i < total; i++) {
                let file = validFiles[i];
                progressText.innerText = `Đang đọc (${i + 1}/${total})`;
                let fileItemId = `file-${i}`;
                fileListEl.innerHTML += `<div class="file-item" id="${fileItemId}"><span class="file-item-name" style="flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">${file.name}</span><span class="status-text" style="color:var(--text-muted); margin-left:8px;">Đang chờ...</span></div>`;
                let fileStatusEl = document.querySelector(`#${fileItemId} .status-text`);
                try {
                    fileStatusEl.innerText = 'Đang đọc...';
                    let data = await extractDataFromSinglePDF(file);
                    currentData.push(data);
                    successCount++;
                    fileStatusEl.innerText = 'Hoàn tất';
                    fileStatusEl.style.color = 'var(--success)';
                } catch (error) {
                    fileStatusEl.innerText = 'Lỗi';
                    fileStatusEl.style.color = 'var(--danger)';
                }
                let percent = Math.round(((i + 1) / total) * 100);
                barFill.style.width = `${percent}%`;
                progressPercent.innerText = `${percent}%`;
            }
            progressText.innerText = `Xong`;
            setTimeout(() => { progressContainer.style.transform = 'translateY(-150%)'; }, 1200);
            
            rebuildDynamicColumns();
            if (!append || activeColumns.length === 0) activeColumns = getDefaultColumns();
            localStorage.setItem('vox_all_active_columns', JSON.stringify(activeColumns));
            
            renderTable();
            persistChanges(true);
            if (append && successCount > 0) showToast(`Đã thêm ${successCount} BN. Tổng: ${currentData.length}`);
        }

        /* ===== TABLE RENDER ===== */
        function getAllColumns() { return [...BASE_COLUMNS, ...dynamicTestCols]; }
        
        function updateWorkspaceStats() {
            const allCols = getAllColumns();
            const activeCount = allCols.filter(c => activeColumns.includes(c.key)).length;
            document.getElementById('statPatientsCount').innerText = currentData.length;
            document.getElementById('statColumnsCount').innerText = `${activeCount}/${allCols.length}`;
            
            const heroView = document.getElementById('uploadHeroContainer');
            const dataView = document.getElementById('dataWorkspace');
            
            if (currentData.length > 0) {
                heroView.style.display = 'none';
                dataView.classList.add('active');
            } else {
                heroView.style.display = 'flex';
                dataView.classList.remove('active');
            }
        }

        function renderTable() {
            updateWorkspaceStats();
            const thead = document.getElementById('tableHead');
            const tbody = document.getElementById('tableBody');
            
            if (currentData.length === 0) {
                thead.innerHTML = '';
                tbody.innerHTML = '';
                return;
            }
            
            let activeCols = getSortedActiveCols();
            if (activeCols.length === 0) {
                thead.innerHTML = '';
                tbody.innerHTML = `<tr><td colspan="10" class="empty-table">Chưa có cột dữ liệu nào được chọn. Hãy bấm <b>Cột dữ liệu</b> để chọn.</td></tr>`;
                return;
            }
            
            // Grouping headers
            let groupedCols = [], currentGroup = null;
            activeCols.forEach(col => {
                let catName = col.category || 'Thông tin Hành chính';
                if (!currentGroup || currentGroup.name !== catName) {
                    currentGroup = { name: catName, count: 0, dotClass: getDotClass(catName) };
                    groupedCols.push(currentGroup);
                }
                currentGroup.count++;
            });
            
            let row1HTML = groupedCols.map(g => `
                <th colspan="${g.count}">
                    <span class="cat-group-title">
                        <span class="color-dot ${g.dotClass}"></span> ${g.name.replace('Xét nghiệm ', '')}
                    </span>
                </th>
            `).join('');
            
            let row2HTML = activeCols.map(c => `<th>${c.label}</th>`).join('');
            thead.innerHTML = `<tr class="tier-group">${row1HTML}</tr><tr class="tier-indicator">${row2HTML}</tr>`;
            
            tbody.innerHTML = currentData.map((row, rowIndex) => {
                let tds = activeCols.map((col) => {
                    let val = '', cellClass = '';
                    if (col.key.startsWith('test_')) {
                        let actualKey = col.key.replace('test_', '');
                        val = row.tests[actualKey] || '';
                        cellClass = 'col-data';
                    } else {
                        val = row[col.key] || '';
                        if (col.key !== 'hoTen') cellClass = 'col-data';
                    }
                    return `<td class="${cellClass}" contenteditable="true" spellcheck="false" data-row="${rowIndex}" data-key="${col.key}" oninput="updateData(${rowIndex}, '${col.key}', this.innerText)">${val}</td>`;
                }).join('');
                return `<tr>${tds}</tr>`;
            }).join('');
        }

        function updateData(rowIndex, key, newValue) {
            if (key.startsWith('test_')) {
                let actualKey = key.replace('test_', '');
                currentData[rowIndex].tests[actualKey] = newValue;
            } else currentData[rowIndex][key] = newValue;
            persistChanges(false);
        }

        function getSortedActiveCols() {
            let allCols = getAllColumns();
            let activeCols = allCols.filter(c => activeColumns.includes(c.key));
            activeCols.sort((a, b) => {
                let catA = a.category || 'Thông tin Hành chính';
                let catB = b.category || 'Thông tin Hành chính';
                let idxA = CATEGORY_ORDER.indexOf(catA), idxB = CATEGORY_ORDER.indexOf(catB);
                if (idxA === -1) idxA = 99; if (idxB === -1) idxB = 99;
                return idxA - idxB;
            });
            return activeCols;
        }

        /* ===== EXPORT & COPY ===== */
        function getTableDataAsArray() {
            let activeCols = getSortedActiveCols();
            let rowGroups = [], rowHeaders = [];
            activeCols.forEach(col => {
                rowGroups.push((col.category || 'Thông tin Hành chính').replace('Xét nghiệm ', ''));
                rowHeaders.push(col.label);
            });
            let rows = currentData.map(row => activeCols.map(col => {
                if (col.key.startsWith('test_')) {
                    let k = col.key.replace('test_', '');
                    return row.tests[k] || '';
                } else return row[col.key] || '';
            }));
            return [rowGroups, rowHeaders, ...rows];
        }

        function copyTableData() {
            if (currentData.length === 0) return showToast("Không có dữ liệu để copy!", true);
            let activeCols = getSortedActiveCols();
            if (activeCols.length === 0) return showToast("Vui lòng chọn ít nhất 1 cột!", true);
            
            let groupedCols = [], currentGroup = null;
            activeCols.forEach(col => {
                let catName = (col.category || 'Thông tin Hành chính').replace('Xét nghiệm ', '');
                if (!currentGroup || currentGroup.name !== catName) { currentGroup = { name: catName, count: 0 }; groupedCols.push(currentGroup); }
                currentGroup.count++;
            });
            
            const FONT_STYLE = "font-family: 'Times New Roman', Times, serif; font-size: 11pt;";
            let html = `<table border="1" cellspacing="0" cellpadding="0" style="border-collapse: collapse; text-align: center; ${FONT_STYLE}">`;
            html += `<tr>`;
            groupedCols.forEach(g => { html += `<th colspan="${g.count}" style="background-color: #f1f5f9; padding: 8px; ${FONT_STYLE} font-weight: bold; border: 1px solid #cbd5e1; text-transform: uppercase;">${g.name}</th>`; });
            html += `</tr><tr>`;
            activeCols.forEach(c => { html += `<th style="background-color: #ffffff; padding: 8px; ${FONT_STYLE} font-weight: bold; border: 1px solid #cbd5e1;">${c.label}</th>`; });
            html += `</tr>`;
            
            currentData.forEach(row => {
                html += `<tr>`;
                activeCols.forEach(col => {
                    let val = '';
                    if (col.key.startsWith('test_')) {
                        let actualKey = col.key.replace('test_', '');
                        val = row.tests[actualKey] || '';
                    } else val = row[col.key] || '';
                    let align = col.key === 'hoTen' ? 'left' : 'center';
                    html += `<td style="padding: 6px 12px; border: 1px solid #cbd5e1; text-align: ${align}; ${FONT_STYLE}">${val}</td>`;
                });
                html += `</tr>`;
            });
            html += `</table>`;
            
            let copyDiv = document.getElementById('hiddenCopyDiv');
            copyDiv.innerHTML = html;
            let range = document.createRange();
            range.selectNodeContents(copyDiv);
            let selection = window.getSelection();
            selection.removeAllRanges();
            selection.addRange(range);
            try {
                if (document.execCommand('copy')) showToast("Đã Copy thành công!");
                else showToast("Lỗi Copy, vui lòng thử lại!", true);
            } catch (err) { showToast("Lỗi Copy, vui lòng thử lại!", true); }
            selection.removeAllRanges();
            copyDiv.innerHTML = '';
            document.getElementById('splitDropdown').classList.remove('show');
        }

        function exportExcel() {
            if (currentData.length === 0) return showToast("Không có dữ liệu để xuất!", true);
            let dataArr = getTableDataAsArray();
            const ws = XLSX.utils.aoa_to_sheet(dataArr);
            let merges = [], startCol = 0, currentGroup = dataArr[0][0];
            for (let i = 0; i < dataArr[0].length; i++) {
                if (dataArr[0][i] !== currentGroup) {
                    if (i - 1 > startCol) merges.push({ s: { r: 0, c: startCol }, e: { r: 0, c: i - 1 } });
                    currentGroup = dataArr[0][i];
                    startCol = i;
                }
            }
            if (dataArr[0].length - 1 > startCol) merges.push({ s: { r: 0, c: startCol }, e: { r: 0, c: dataArr[0].length - 1 } });
            ws['!merges'] = merges;
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, "KetQuaXN");
            ws['!cols'] = dataArr[0].map(() => ({ wch: 16 }));
            XLSX.writeFile(wb, `KetQuaXN_${new Date().toISOString().slice(0, 10)}.xlsx`);
            showToast("Đã xuất file Excel!");
            document.getElementById('splitDropdown').classList.remove('show');
        }

        /* ===== HISTORY ===== */
        function saveToHistory() {
            if (currentData.length === 0) return showToast("Không có dữ liệu để lưu!", true);
            let history = JSON.parse(localStorage.getItem('vox_history')) || [];
            let newRecord = {
                id: Date.now(),
                time: new Date().toLocaleString('vi-VN'),
                count: currentData.length,
                data: currentData
            };
            history.unshift(newRecord);
            localStorage.setItem('vox_history', JSON.stringify(history));
            renderHistory();

            if (firebaseInitState === 'ready') {
                saveHistoryToFirebase(newRecord).then(() => {
                    showToast(`Đã lưu và đồng bộ Cloud!`);
                }).catch(() => {
                    showToast("Đã lưu local — Lỗi Cloud!", true);
                });
            } else {
                showToast(`Đã lưu local!`);
            }
        }

        function renderHistory() {
            const history = JSON.parse(localStorage.getItem('vox_history')) || [];
            const listEl = document.getElementById('historyList');

            if (history.length === 0) {
                listEl.innerHTML = `<div style="text-align:center; padding: 40px 0; color: var(--text-muted); font-size: 13px;">Chưa có lịch sử lưu trữ.</div>`;
                return;
            }

            const docIcon = `<svg class="svg-icon" style="color: var(--primary);" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>`;

            listEl.innerHTML = history.map(item => {
                const data = item.data || [];
                const count = item.count || data.length;
                const isConfirmingDelete = (pendingDeleteHistoryId === item.id);
                const visiblePatients = data.slice(0, 3);
                const remaining = count - visiblePatients.length;
                const patientChips = visiblePatients.map(p => `<span class="patient-chip">${p.hoTen || 'BN'}</span>`).join('') + 
                                     (remaining > 0 ? `<span class="patient-chip" style="background:var(--primary-light);color:var(--primary);">+${remaining}</span>` : '');

                return `
                <div class="history-item">
                    <div class="history-meta">
                        <div class="history-time" style="display:flex; align-items:center; gap:6px;">${docIcon} ${item.time}</div>
                        <div class="history-count">${count} BN</div>
                    </div>
                    <div class="history-patients">${patientChips || '<span style="font-size:12px; color:var(--text-muted);">Không có dữ liệu</span>'}</div>
                    <div class="history-actions">
                        <button class="btn" onclick="previewHistory(${item.id})">Xem</button>
                        <button class="btn" onclick="loadHistory(${item.id})">Khôi phục</button>
                        ${isConfirmingDelete
                            ? `<button class="btn" style="background:var(--danger); color:#fff; border-color:var(--danger);" onclick="confirmDeleteHistory(${item.id})">Xác nhận xoá</button>`
                            : `<button class="btn btn-icon-only danger" style="width:28px; height:28px;" onclick="requestDeleteHistory(${item.id})"><svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button>`
                        }
                    </div>
                </div>`;
            }).join('');
        }

        function loadHistory(id) {
            let history = JSON.parse(localStorage.getItem('vox_history')) || [];
            let record = history.find(item => item.id === id);
            if (record) {
                currentData = record.data;
                rebuildDynamicColumns();
                if (activeColumns.length <= BASE_COLUMNS.length) activeColumns = getDefaultColumns();
                renderTable();
                closeAllDrawers();
                persistChanges(true);
                showToast("Đã khôi phục dữ liệu!");
            }
        }

        function requestDeleteHistory(id) {
            pendingDeleteHistoryId = id;
            renderHistory();
            setTimeout(() => {
                if (pendingDeleteHistoryId === id) {
                    pendingDeleteHistoryId = null;
                    renderHistory();
                }
            }, 3500);
        }

        function confirmDeleteHistory(id) {
            pendingDeleteHistoryId = null;
            let history = JSON.parse(localStorage.getItem('vox_history')) || [];
            history = history.filter(item => item.id !== id);
            localStorage.setItem('vox_history', JSON.stringify(history));
            renderHistory();
            if (firebaseInitState === 'ready') {
                deleteHistoryFromFirebase(id).catch(err => console.error(err));
            }
        }

        /* ===== PREVIEW MODAL ===== */
        function previewHistory(id) {
            const history = JSON.parse(localStorage.getItem('vox_history')) || [];
            const record = history.find(item => item.id === id);
            if (!record) return showToast("Không tìm thấy!", true);

            previewHistoryId = id;
            document.getElementById('previewTime').innerText = record.time;
            const data = record.data || [];
            document.getElementById('previewCount').innerText = data.length;

            document.getElementById('previewTableBody').innerHTML = data.map((p, idx) => {
                const testsCount = Object.keys(p.tests || {}).length;
                return `<tr>
                    <td style="text-align:center; color: var(--text-muted); font-family: 'JetBrains Mono', monospace;">${idx + 1}</td>
                    <td style="font-weight: 500;">${p.hoTen || '-'}</td>
                    <td style="text-align:center;">${p.tuoi || '-'}</td>
                    <td style="text-align:center;">${p.gioiTinh || '-'}</td>
                    <td style="text-align:center;"><span style="font-family: 'JetBrains Mono', monospace; color: var(--primary);">${testsCount}</span></td>
                </tr>`;
            }).join('');

            document.getElementById('previewModal').classList.add('active');
        }
        function closePreview() {
            document.getElementById('previewModal').classList.remove('active');
            previewHistoryId = null;
        }
        function restoreFromPreview() {
            if (previewHistoryId) {
                const id = previewHistoryId;
                closePreview();
                loadHistory(id);
            }
        }
    </script>
</body>
</html>
