        .preview-table tbody tr:hover td { background: var(--bg-subtle); }
        .preview-empty { text-align: center; padding: 40px 20px; color: var(--text-muted); }

        /* TOAST NOTIFICATION (TOP RIGHT) */
        #toast {
            visibility: hidden;
            min-width: 280px;
            max-width: 420px;
            background: #0f172a;
            color: #fff;
            border-radius: 8px;
            padding: 14px 18px;
            position: fixed;
            z-index: 9999;
            top: 76px; /* 60px thanh header + 16px margin */
            right: 24px;
            font-size: 13.5px;
            font-weight: 500;
            display: flex;
